{
    "python.testing.pytestArgs": [
        "tests"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "python.testing.pytestPath": "pytest",
    "python.testing.cwd": "${workspaceFolder}",
    // Pylance performance optimizations (VS Code specific only)
    "python.analysis.packageIndexDepths": [
        {
            "name": "homeassistant",
            "depth": 1,
            "includeAllSymbols": false
        }
    ],
    "python.analysis.autoFormatStrings": false,
    // File watching optimizations
    "files.watcherExclude": {
        "**/__pycache__/**": true,
        "**/htmlcov/**": true,
        "coverage.json": true,
        "coverage.xml": true,
        "**/.git/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true
    },
    // Editor performance
    "editor.quickSuggestions": {
        "strings": false,
        "comments": false,
        "other": true
    },
    "editor.suggest.localityBonus": true,
    "editor.suggest.shareSuggestSelections": false,
    // Disable resource-intensive features during editing
    "python.analysis.inlayHints.functionReturnTypes": false,
    "python.analysis.inlayHints.variableTypes": false,
    "editor.codeLens": false,
    "editor.hover.delay": 1000,
    // Additional performance optimizations
    "python.analysis.completeFunctionParens": false,
    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#f3895b",
        "activityBar.background": "#f3895b",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#c4fbd4",
        "activityBarBadge.foreground": "#15202b",
        "commandCenter.border": "#15202b99",
        "sash.hoverBorder": "#f3895b",
        "statusBar.background": "#ef672c",
        "statusBar.foreground": "#15202b",
        "statusBarItem.hoverBackground": "#d84d10",
        "statusBarItem.remoteBackground": "#ef672c",
        "statusBarItem.remoteForeground": "#15202b",
        "titleBar.activeBackground": "#ef672c",
        "titleBar.activeForeground": "#15202b",
        "titleBar.inactiveBackground": "#ef672c99",
        "titleBar.inactiveForeground": "#15202b99"
    },
    // Copilot and Chat Settings: allow automatic approval and terminal file writes (this is a devcontainer)
    "chat.permissions.default": "autoApprove",
    "chat.tools.terminal.blockDetectedFileWrites": "never"
}